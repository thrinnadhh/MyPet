# MyPet — Required Environment Variables
# =========================================
# Copy this file to .env and fill in all values before running docker-compose.
# DO NOT commit .env to source control.
#
# NOTE: docker-compose.replicas.yml uses ${VAR:?error} syntax for critical secrets.
# Docker Compose will refuse to start if any of these are missing or empty.

# ---- Security ----
# A strong random secret shared between api-gateway and all microservices.
# Generate with: openssl rand -hex 32
GATEWAY_SECRET=

# Secret for internal service-to-service calls.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# ---- Razorpay ----
# Set to "false" in production. "true" only for local developer machines.
RAZORPAY_SANDBOX_MODE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# ---- Public URLs ----
# The HTTPS domain where the API gateway is reachable externally.
# Used for media URLs in provider and chat responses.
PROVIDER_PUBLIC_BASE_URL=https://api.mypet.in
CHAT_PUBLIC_BASE_URL=https://api.mypet.in

# ---- Database ----
DB_URL=jdbc:postgresql://postgres:5432/pawsnearme?stringtype=unspecified
DB_USERNAME=postgres
DB_PASSWORD=

# ---- Notifications ----
# EXPO_FCM for production push notifications. LOGGED_DEV for local dev only.
NOTIFICATION_DELIVERY_MODE=EXPO_FCM

# ---- Expo Push ----
EXPO_ACCESS_TOKEN=
