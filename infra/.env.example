# MyPet — Required Environment Variables
# =========================================
# Copy this file to .env.production and fill in every required production value.
# DO NOT commit the populated file to source control.
#
# Production/rollback Compose uses ${VAR:?error} for critical values and the
# modular-monolith runtime performs an additional fail-closed validation pass.

# ---- Runtime ----
SPRING_PROFILES_ACTIVE=production
PUBLIC_URL=https://api.mypet.in

# ---- Security ----
# Generate independent secrets; do not reuse one value across purposes.
# Example: openssl rand -hex 32
GATEWAY_SECRET=
INTERNAL_API_SECRET=
PAYMENT_CHECKOUT_TOKEN_SECRET=
MEDICAL_DOCUMENT_SIGNING_KEY=
CASE_EVIDENCE_SIGNING_KEY=

# AES key used to protect captain banking data. Preserve the existing required
# format used by the captain service rather than placing a passphrase here.
BANK_DATA_ENCRYPTION_KEY=

# ---- Supabase / JWT verification ----
SUPABASE_URL=
# Preferred production verification path.
SUPABASE_JWT_JWK_SET_URI=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# Optional legacy/shared-secret verification path when explicitly required.
SUPABASE_JWT_SECRET=
ALLOW_UNSIGNED_JWT=false

# ---- CORS ----
# Comma-separated explicit HTTPS origins only. Never use * or localhost in production.
GATEWAY_CORS_ALLOWED_ORIGINS=https://admin.mypet.in

# ---- Cashfree Payments ----
CASHFREE_SANDBOX_MODE=false
CASHFREE_API_VERSION=2025-01-01
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=

# ---- Database ----
POSTGRES_DB=pawsnearme
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DB_URL=jdbc:postgresql://postgres:5432/pawsnearme?stringtype=unspecified
DB_USERNAME=postgres
DB_PASSWORD=

# ---- Redis / Kafka ----
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ---- Private medical/support storage ----
MEDICAL_REPORTS_BUCKET=
MEDICAL_REPORTS_REGION=ap-south-1
MEDICAL_REPORTS_ACCESS_KEY=
MEDICAL_REPORTS_SECRET_KEY=

# ---- External API URLs used inside generated links ----
APPOINTMENT_MEDICAL_DOCUMENTS_PUBLIC_BASE_URL=https://api.mypet.in
ORDER_CASE_EVIDENCE_PUBLIC_BASE_URL=https://api.mypet.in
PROVIDER_PUBLIC_BASE_URL=https://api.mypet.in
CHAT_PUBLIC_BASE_URL=https://api.mypet.in

# ---- Notifications ----
NOTIFICATION_DELIVERY_MODE=EXPO_FCM
EXPO_ACCESS_TOKEN=

# ---- Operational safety ----
MYPET_TRUST_FORWARDED_FOR=false
ORDER_ONLINE_PAYMENTS_ENABLED=true
