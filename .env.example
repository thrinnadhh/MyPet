# ─────────────────────────────────────────────────────────────────────────────
# PawsNearMe — Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev defaults use the Docker Compose postgres container (port 5433)
DB_URL=jdbc:postgresql://localhost:5433/pawsnearme?currentSchema=public&stringtype=unspecified
DB_USERNAME=postgres
DB_PASSWORD=changeme

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Use kafka:29092 for inter-container Docker communication
# Use localhost:9092 for host-side access
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380

# ── Service URLs (used by API Gateway) ───────────────────────────────────────
# Override with Docker service names (e.g. http://provider-service:8081) in compose
PROVIDER_SERVICE_URL=http://localhost:8081
CATALOG_SERVICE_URL=http://localhost:8082
DISCOVERY_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_URL=http://localhost:8084
APPOINTMENT_SERVICE_URL=http://localhost:8085
DISPATCH_SERVICE_URL=http://localhost:8086
CAPTAIN_SERVICE_URL=http://localhost:8087
NOTIFICATION_SERVICE_URL=http://localhost:8088
REVIEW_SERVICE_URL=http://localhost:8089
PAYMENT_SERVICE_URL=http://localhost:8090
CONTENT_SERVICE_URL=http://localhost:8092
CHAT_SERVICE_URL=http://localhost:8091

# ── Push, uploads, and background jobs ───────────────────────────────────────
# Real Expo push delivery (use LOGGED_DEV for log-only local testing)
NOTIFICATION_DELIVERY_MODE=EXPO_FCM

# Public URL returned in upload fileUrl responses — use the API gateway so mobile
# clients can fetch uploaded captain/merchant documents through one host.
PROVIDER_PUBLIC_BASE_URL=http://localhost:8080

# Shared secret for service-to-service calls (vaccination reminder sync)
INTERNAL_API_SECRET=dev-internal-secret

# Hours after DELIVERED before orders auto-transition to COMPLETED
ORDER_AUTO_COMPLETE_HOURS=1

# ── JPA / Debug ───────────────────────────────────────────────────────────────
JPA_SHOW_SQL=false   # Set to true for local development

# ── gRPC ──────────────────────────────────────────────────────────────────────
GRPC_PORT=9091

# ── Supabase (Sprint 3 — Auth) ────────────────────────────────────────────────
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>   # Backend only — NEVER expose to mobile
SUPABASE_JWT_JWK_SET_URI=https://<your-project>.supabase.co/auth/v1/.well-known/jwks.json
