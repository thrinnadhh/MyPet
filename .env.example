# ─────────────────────────────────────────────────────────────────────────────
# PawsNearMe / MyPet — Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env or real provider credentials to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev defaults use the Docker Compose postgres container (port 5433)
DB_URL=jdbc:postgresql://localhost:5433/pawsnearme?currentSchema=public&stringtype=unspecified
DB_USERNAME=postgres
DB_PASSWORD=changeme

# ── Kafka ─────────────────────────────────────────────────────────────────────
# Use kafka:29092 for inter-container Docker communication
# Use localhost:9092 for host-side access
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380

# ── Service URLs (used by API Gateway) ───────────────────────────────────────
# Override with Docker service names (e.g. http://provider-service:8081) in compose
PROVIDER_SERVICE_URL=http://localhost:8081
CATALOG_SERVICE_URL=http://localhost:8082
DISCOVERY_SERVICE_URL=http://localhost:8083
ORDER_SERVICE_URL=http://localhost:8084
APPOINTMENT_SERVICE_URL=http://localhost:8085
DISPATCH_SERVICE_URL=http://localhost:8086
CAPTAIN_SERVICE_URL=http://localhost:8087
NOTIFICATION_SERVICE_URL=http://localhost:8088
REVIEW_SERVICE_URL=http://localhost:8089
PAYMENT_SERVICE_URL=http://localhost:8090
CONTENT_SERVICE_URL=http://localhost:8092
CHAT_SERVICE_URL=http://localhost:8091

# ── Push, uploads, and background jobs ───────────────────────────────────────
# Real Expo push delivery (use LOGGED_DEV for log-only local testing)
NOTIFICATION_DELIVERY_MODE=EXPO_FCM

# Public URL returned in upload fileUrl responses — use the API gateway so mobile
# clients can fetch uploaded captain/merchant documents through one host.
PROVIDER_PUBLIC_BASE_URL=http://localhost:8080

# Shared secret for service-to-service calls (vaccination reminder sync)
INTERNAL_API_SECRET=dev-internal-secret

# Browser origins allowed to call the API gateway. Use explicit HTTPS origins in production.
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Hours after DELIVERED before orders auto-transition to COMPLETED
ORDER_AUTO_COMPLETE_HOURS=1

# Keep false until Cashfree credentials, signed webhooks, and server-owned payment
# reconciliation are configured and certified in the target environment.
ORDER_ONLINE_PAYMENTS_ENABLED=false

# ── Transactional email: MSG91 primary -> Brevo backup ────────────────────────
# Keep false until both sender domains and templates have been configured.
TRANSACTIONAL_EMAIL_ENABLED=false
TRANSACTIONAL_EMAIL_MAX_ATTEMPTS=5
TRANSACTIONAL_EMAIL_RETRY_INTERVAL_MS=60000

# MSG91 Email
MSG91_AUTH_KEY=<set-in-secret-manager>
MSG91_EMAIL_DOMAIN=<verified-sending-domain>
MSG91_EMAIL_FROM=<verified-from-address>
MSG91_EMAIL_FROM_NAME=MyPet
MSG91_EMAIL_MONTHLY_LIMIT=5000
MSG91_EMAIL_TEMPLATE_ORDER_PLACED=<msg91-template-slug>
MSG91_EMAIL_TEMPLATE_ORDER_DELIVERED=<msg91-template-slug>
MSG91_EMAIL_TEMPLATE_APPOINTMENT_BOOKED=<msg91-template-slug>

# Brevo backup Email
BREVO_API_KEY=<set-in-secret-manager>
BREVO_EMAIL_FROM=<verified-from-address>
BREVO_EMAIL_FROM_NAME=MyPet
BREVO_EMAIL_TEMPLATE_ORDER_PLACED=<numeric-template-id>
BREVO_EMAIL_TEMPLATE_ORDER_DELIVERED=<numeric-template-id>
BREVO_EMAIL_TEMPLATE_APPOINTMENT_BOOKED=<numeric-template-id>

# ── JPA / Debug ───────────────────────────────────────────────────────────────
JPA_SHOW_SQL=false   # Set to true for local development

# ── gRPC ──────────────────────────────────────────────────────────────────────
GRPC_PORT=9091

# ── Supabase Auth ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>   # Backend only — NEVER expose to mobile
SUPABASE_JWT_JWK_SET_URI=https://<your-project>.supabase.co/auth/v1/.well-known/jwks.json

# Expo customer app public values (publishable/anon key only; never service-role)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-publishable-or-anon-key>

# ── Supabase Edge Function secrets: send-sms-hook ─────────────────────────────
# These belong in Supabase Edge Function secrets, NOT in the customer app bundle.
SEND_SMS_HOOK_SECRET=<generated-by-supabase-auth-hooks>
MSG91_SMS_TEMPLATE_ID=<msg91-sms-flow-template-id>
MSG91_OTP_VARIABLE=VAR1
# MSG91_AUTH_KEY is also required by the Edge Function and should be set there as a secret.
