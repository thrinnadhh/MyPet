{
  "title": "PawsNearMe Sprint 8 Operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["pawsnearme", "sprint-8", "hardening"],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate By Service",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[5m])) by (application, method, status)"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx Error Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) by (application)"
        }
      ]
    },
    {
      "id": 3,
      "title": "P95 Latency By Route",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, application, uri))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Billing Requests And Failures",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/catalog/bills.*\"}[5m])) by (status)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Kafka Producer Errors",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(kafka_producer_record_error_total[5m])) by (client_id)"
        }
      ]
    },
    {
      "id": 6,
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(kafka_consumergroup_lag) by (consumergroup, topic)"
        }
      ]
    },
    {
      "id": 7,
      "title": "Redis Command Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "redis_commands_duration_seconds_total / redis_commands_processed_total"
        }
      ]
    },
    {
      "id": 8,
      "title": "Database Pool Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "hikaricp_connections_active / hikaricp_connections_max"
        }
      ]
    }
  ]
}
