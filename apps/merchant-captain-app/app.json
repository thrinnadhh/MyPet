{
  "expo": {
    "name": "MyPet Operations",
    "slug": "merchant-captain-app",
    "version": "0.9.0-beta.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "merchantcaptainapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "buildNumber": "1",
      "bundleIdentifier": "com.pawsnearme.merchantcaptainapp"
    },
    "android": {
      "package": "com.pawsnearme.merchantcaptainapp",
      "versionCode": 901,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MyPet Captain to use your location to receive nearby delivery offers and share delivery progress.",
          "locationAlwaysAndWhenInUsePermission": "Allow MyPet Captain to use your location while you are online or completing an active delivery.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/order_alert.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "releaseChannel": "internal-beta",
      "releaseVersion": "v0.9.0-beta.1"
    }
  }
}
